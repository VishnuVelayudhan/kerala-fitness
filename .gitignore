**/.netlify/
.vercel/
**/.vercel/

# Local database files & binaries
*.db
*.sqlite
*.sqlite3
fitness.db
**/fitness.db

# Logs & debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

