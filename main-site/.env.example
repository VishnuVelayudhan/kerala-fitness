# ==========================================
# Kerala Fitness App - Environment Template
# ==========================================
# Duplicate this file as .env and fill in your values.
# NEVER commit your actual .env file to version control.

# Turso / LibSQL Database Configuration
# Obtain URL and Auth Token from: https://turso.tech
LIBSQL_URL=libsql://your-database-name.turso.io
LIBSQL_AUTH_TOKEN=your_turso_auth_token_here

# Cloudinary Storage Configuration (for user photo/media uploads)
# Obtain credentials from: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Server Port (for local Node.js / Express development)
PORT=8888
